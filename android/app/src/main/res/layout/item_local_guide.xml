<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtGuideFilename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtGuideMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemIngest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/signal_emerald"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Ingest"
            android:textColor="@color/on_signal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemPreview"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Preview"
            android:textColor="@color/signal"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Delete"
            android:textColor="@color/danger"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
